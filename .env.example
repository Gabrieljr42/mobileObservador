# Copie para .env e ajuste para o seu ambiente. Nunca commite o .env.
# Aparelho físico na mesma rede: http://SEU_IP_LOCAL:8000 (ex.: http://192.168.0.105:8000)
# Emulador Android: http://10.0.2.2:8000
# Navegador (--web): http://localhost:8000
EXPO_PUBLIC_API_BASE_URL=https://api.observador.tech

# APP_URL is only used as the Expo Router web origin when needed.
APP_URL=https://api.observador.tech
